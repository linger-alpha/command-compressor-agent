{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "required": ["verdicts"],
  "properties": {
    "verdicts": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["rule_id", "approved", "pass_rate", "complaints"],
        "properties": {
          "rule_id": { "type": "string" },
          "approved": { "type": "boolean" },
          "pass_rate": { "type": "number", "minimum": 0, "maximum": 1 },
          "complaints": {
            "type": "array",
            "maxItems": 20,
            "items": { "type": "string", "maxLength": 1000 }
          }
        }
      }
    }
  }
}
